    {
      "id": "b2b-006",
      "name": "Confirm saved enquiry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const saved = $input.first().json;\nconst requestId = $('Validate audit').first().json.lead.requestId;\nif (saved.requestId !== requestId) throw new Error('Saved lead acknowledgement mismatch');\nreturn [{json:{ok:true,requestId}}];"
