      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "b2b-audit-v1",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "position": [
        0,
        0
      ],
      "webhookId": "c080de30-3ba1-4cb8-b757-4c8a147c6d37"
    },
    {
      "id": "b2b-002",
      "name": "Configure destination",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sheet-id",
              "name": "spreadsheet_id",
              "value": "SET_SPREADSHEET_ID",
              "type": "string"
            },
            {
              "id": "sheet-name",
              "name": "sheet_name",
              "value": "Website enquiries",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "position": [
        240,
        0
      ]
    },
    {
      "id": "b2b-003",
      "name": "Validate audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const normalizeAuditPayload = function normalizeAuditPayload(data) {\n  const validList = (value, maxItems) => Array.isArray(value) && value.length > 0 &&\n    value.length <= maxItems && value.every(item => typeof item === 'string' && item.trim() && item.length <= 200);\n  if (!data || typeof data !== 'object' || Array.isArray(data) ||\n      typeof data.requestId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(data.requestId) ||\n      typeof data.name !== 'string' || !data.name.trim() || data.name.length > 120 ||\n      typeof data.email !== 'string' || data.email.length > 254 || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(data.email.trim()) ||\n      !validList(data.bottlenecks, 4) || !validList(data.tools, 8) ||\n      !['1 – 5 hrs / person', '5 – 15 hrs / person', '15+ hrs / person'].includes(data.hoursLost)) {\n    throw new Error('Please complete all questions and enter a valid name and email.');\n  }\n  return {\n    requestId: data.requestId,\n    name: data.name.trim(),\n    email: data.email.trim().toLowerCase(),\n    bottlenecks: [...new Set(data.bottlenecks.map(item => item.trim()))],\n    tools: [...new Set(data.tools.map(item => item.trim()))],\n    hoursLost: data.hoursLost,\n    source: 'website-audit',\n  };\n};\nconst input = $input.first().json;\ntry {\n  const lead = normalizeAuditPayload(input.body);\n  if (!/^[a-zA-Z0-9_-]{20,}$/.test(input.spreadsheet_id || '') || input.spreadsheet_id === 'SET_SPREADSHEET_ID') {\n    return [{json:{valid:false,responseCode:503,response:{ok:false,error:'Lead storage is not configured.'}}}];\n  }\n  return [{json:{valid:true,spreadsheet_id:input.spreadsheet_id,sheet_name:input.sheet_name,\n    lead:{...lead,receivedAt:new Date().toISOString()}}}];\n} catch {\n  return [{json:{valid:false,responseCode:400,response:{ok:false,error:'Invalid audit request.'}}}];\n}"
      },
      "position": [
        480,
        0
      ]
    },
    {
      "id": "b2b-004",
      "name": "Valid request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        720,
        0
      ]
    },
    {
      "id": "b2b-005",
      "name": "Save enquiry",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "parameters": {
        "resource": "sheet",
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.spreadsheet_id }}",
          "mode": "id"
        },
        "sheetName": {
