            "name": "={{ $json.lead.name }}",
            "email": "={{ $json.lead.email }}",
            "bottlenecks": "={{ JSON.stringify($json.lead.bottlenecks) }}",
            "tools": "={{ JSON.stringify($json.lead.tools) }}",
            "hoursLost": "={{ $json.lead.hoursLost }}",
            "source": "={{ $json.lead.source }}",
            "receivedAt": "={{ $json.lead.receivedAt }}"
          },
          "schema": [
