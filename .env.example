# Server-only: the active n8n production Webhook URL. Never prefix these with VITE_.
N8N_AUDIT_WEBHOOK_URL=
# Optional, matching n8n Header Auth: Authorization: Bearer <token>.
N8N_AUDIT_WEBHOOK_TOKEN=

# Public, optional. Links are hidden until valid destinations are configured.
VITE_BOOKING_URL=
VITE_CONTACT_EMAIL=
